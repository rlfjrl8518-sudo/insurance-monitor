# 이 파일을 .env 로 복사한 뒤 실제 값을 채워주세요. (.env는 git에 커밋되지 않습니다)

# AI 분류: Vertex AI Gemini (GCP 프로젝트 insurance-monitor-playd, 계정 playddmt1@gmail.com)
# 로컬에서는 서비스계정 키 파일 경로를, Actions에서는 GCP_SERVICE_ACCOUNT_JSON(키 JSON 전체)을 쓴다.
GCP_SERVICE_ACCOUNT_FILE=
GCP_PROJECT_ID=insurance-monitor-playd
# 비워두면 config.json ai.models 후보를 순서대로 시도한다. 쉼표로 여러 개.
AI_MODELS=

# 웹앱 DB (Neon). 적재(push_to_postgres.py)와 eval_labels.py가 쓴다.
DATABASE_URL=

# 결과를 저장할 구글 시트의 ID (URL의 /d/ 와 /edit 사이 값)
GOOGLE_SHEETS_ID=

# 이미지를 저장할 구글 드라이브 폴더의 ID
GOOGLE_DRIVE_FOLDER_ID=

# apps_script/이미지업로드.gs 를 배포한 웹앱 URL
DRIVE_UPLOAD_WEBAPP_URL=

# apps_script/이미지업로드.gs 의 BIMIL_KEY와 동일한 값
DRIVE_UPLOAD_SECRET=
