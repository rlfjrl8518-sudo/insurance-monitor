# 이 파일을 .env 로 복사한 뒤 실제 값을 채워주세요. (.env는 git에 커밋되지 않습니다)

# NVIDIA NIM API 키 (build.nvidia.com 에서 발급, nvapi- 로 시작)
NVIDIA_API_KEY=

# 아래 3개는 비워두면 config.json 값을 쓴다. 급히 모델만 바꿔야 할 때만 채운다.
NVIDIA_MODEL=
NVIDIA_VISION_MODEL=
NVIDIA_BASE_URL=

# 결과를 저장할 구글 시트의 ID (URL의 /d/ 와 /edit 사이 값)
GOOGLE_SHEETS_ID=

# 이미지를 저장할 구글 드라이브 폴더의 ID
GOOGLE_DRIVE_FOLDER_ID=

# apps_script/이미지업로드.gs 를 배포한 웹앱 URL
DRIVE_UPLOAD_WEBAPP_URL=

# apps_script/이미지업로드.gs 의 BIMIL_KEY와 동일한 값
DRIVE_UPLOAD_SECRET=
